---
import Layout from '../layouts/Layout.astro';
import publicationsData from '../data/publications.json';

const { publications, thesis } = publicationsData;
const journalPubs = publications.filter(p => p.type !== 'book-chapter').sort((a, b) => b.year - a.year);
const bookChapters = publications.filter(p => p.type === 'book-chapter').sort((a, b) => b.year - a.year);

const toc = [
	{ id: 'about', label: 'About' },
	{ id: 'research', label: 'Research themes' },
	{ id: 'publications', label: 'Publications' },
	{ id: 'software', label: 'Software & methods' },
	{ id: 'cv', label: 'CV', children: [
		{ id: 'cv-experience', label: 'Experience' },
		{ id: 'cv-education', label: 'Education' },
		{ id: 'cv-teaching', label: 'Teaching' }
	]},
	{ id: 'media', label: 'Selected media coverage' }
];
---

<Layout title="Alexandre Gouy, PhD">
	<nav class="mobile-toc" aria-label="Section navigation">
		<ul>
			{toc.map(item => (
				<li><a href={`#${item.id}`} class="toc-link" data-target={item.id}>{item.label}</a></li>
			))}
		</ul>
	</nav>

	<section id="about" class="hero">
		<div class="hero-content">
			<div class="hero-image">
				<img src="/profile_pic.jpg" alt="Alexandre Gouy" class="profile-pic" />
			</div>
			<div class="hero-text">
				<h1>Alexandre Gouy<span class="title-suffix">, PhD</span></h1>
				<p class="tagline">Evolutionary Geneticist &bull; Computational Biologist</p>
				<p class="intro">
					I study how populations adapt to their environment: the genetic architectures that enable it,
					the selective pressures that shape it, and the computational methods needed to detect it.
					From archaic introgression in humans to rapid radiation in rodents, my work sits at the
					intersection of evolutionary theory, population genomics, and machine learning.
				</p>
				<div class="hero-links">
					<a href="#publications" class="btn btn-primary">Publications</a>
					<a href="#cv" class="btn btn-secondary">CV</a>
				</div>
			</div>
		</div>
	</section>

	<div class="page-grid">
		<aside class="toc" aria-label="Table of contents">
			<nav>
				<p class="toc-title">On this page</p>
				<ul>
					{toc.map(item => (
						<li>
							<a href={`#${item.id}`} class="toc-link" data-target={item.id}>{item.label}</a>
							{item.children && (
								<ul class="toc-sub">
									{item.children.map(child => (
										<li><a href={`#${child.id}`} class="toc-link toc-link-sub" data-target={child.id}>{child.label}</a></li>
									))}
								</ul>
							)}
						</li>
					))}
				</ul>
			</nav>
		</aside>

		<div class="page-content">
			<section id="research" class="section">
				<h2>Research themes</h2>
				<div class="cards">
					<div class="card">
						<img class="card-icon" src="/tree-branch-svgrepo-com.svg" alt="" />
						<h3>Adaptation & Natural Selection</h3>
						<p>Polygenic selection, adaptive introgression, and the interplay between drift and selection (from archaic humans to conservation genomics of tigers).</p>
					</div>
					<div class="card">
						<img class="card-icon" src="/dna-svgrepo-com.svg" alt="" />
						<h3>Population Genomics & Genetic Architecture</h3>
						<p>Demographic inference, epistasis, and the polygenic basis of complex traits. Statistical methods and software (fastsimcoal2, STRAF). Why most heritability remains missing.</p>
					</div>
					<div class="card">
						<img class="card-icon" src="/console-svgrepo-com.svg" alt="" />
						<h3>Computational Methods</h3>
						<p>Machine learning for genomics, simulation-based inference, and AI-assisted research workflows applied to evolutionary and biomedical questions.</p>
					</div>
					<div class="card">
						<img class="card-icon" src="/knowledge-education-creativity-inspiration-intelligence-svgrepo-com.svg" alt="" />
						<h3>Epistemology & Honest Science</h3>
						<p>Replication crisis, incentive structures in academia, and the role of methodology in producing reliable knowledge. How computational tools can enforce transparency and reproducibility.</p>
					</div>
				</div>
			</section>

			<section id="publications" class="section">
				<h2>Publications</h2>
				<p class="section-note">* denotes first or corresponding author</p>

				<h3 class="sub-heading">Journal articles</h3>
				{journalPubs.map(pub => (
					<div class="publication">
						<span class="pub-year">{pub.year}</span>
						<div class="pub-content">
							<h4>{pub.doi ? <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">{pub.title}</a> : pub.title}{pub.firstAuthor ? ' *' : ''}</h4>
							<p class="pub-authors" set:html={pub.authors}></p>
							<p class="pub-venue">
								{pub.venue}
								{pub.status && <span class="pub-status">{pub.status}</span>}
							</p>
						</div>
					</div>
				))}

				<h3 class="sub-heading">Book chapters</h3>
				{bookChapters.map(pub => (
					<div class="publication">
						<span class="pub-year">{pub.year}</span>
						<div class="pub-content">
							<h4>{pub.doi ? <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">{pub.title}</a> : pub.title}{pub.firstAuthor ? ' *' : ''}</h4>
							<p class="pub-authors" set:html={pub.authors}></p>
							<p class="pub-venue">{pub.venue}</p>
						</div>
					</div>
				))}

				<h3 class="sub-heading">PhD thesis</h3>
				<div class="publication thesis">
					<span class="pub-year">{thesis.year}</span>
					<div class="pub-content">
						<h4>{thesis.title}</h4>
						<p class="pub-authors"><strong>Gouy A</strong></p>
						<p class="pub-venue">{thesis.venue} &mdash; <em>{thesis.honors}</em></p>
						<p class="pub-description">Statistical methods for detecting selection in large-scale genomic datasets, with applications to human evolution and adaptation. Supervisor: {thesis.supervisor}.</p>
					</div>
				</div>
			</section>

			<section id="software" class="section">
				<h2>Software & methods</h2>
				<div class="software-grid">
					<div class="software-card featured">
						<div class="software-header">
							<h4>STRAF</h4>
							<span class="software-badge">Lead Developer</span>
						</div>
						<p>Online tool for STR data evaluation in forensic genetics.</p>
						<div class="software-meta">
							<span class="tech">R, Shiny</span>
						</div>
						<div class="software-links">
							<a href="https://github.com/agouy/straf" target="_blank" rel="noopener">GitHub</a>
							<a href="https://straf.fr" target="_blank" rel="noopener">Live App</a>
							<a href="https://doi.org/10.1016/j.fsigen.2017.03.012" target="_blank" rel="noopener">Paper</a>
						</div>
					</div>
					<div class="software-card featured">
						<div class="software-header">
							<h4>fastsimcoal2</h4>
							<span class="software-badge">Co-developer</span>
						</div>
						<p>Demographic inference under complex evolutionary scenarios.</p>
						<div class="software-meta">
							<span class="tech">C++</span>
						</div>
						<div class="software-links">
							<a href="http://cmpg.unibe.ch/software/fastsimcoal2/" target="_blank" rel="noopener">Website</a>
							<a href="https://doi.org/10.1093/bioinformatics/btab004" target="_blank" rel="noopener">Paper</a>
						</div>
					</div>
					<div class="software-card">
						<div class="software-header">
							<h4>signet</h4>
							<span class="software-badge">Lead Developer</span>
						</div>
						<p>R package for detection of gene subnetworks under selection in biological pathways.</p>
						<div class="software-meta">
							<span class="tech">R</span>
						</div>
						<div class="software-links">
							<a href="https://github.com/cmpg/signet" target="_blank" rel="noopener">GitHub</a>
							<a href="https://cran.r-project.org/package=signet" target="_blank" rel="noopener">CRAN</a>
							<a href="https://doi.org/10.1093/nar/gkx626" target="_blank" rel="noopener">Paper</a>
						</div>
					</div>
					<div class="software-card">
						<div class="software-header">
							<h4>Tercen Operators</h4>
							<span class="software-badge">Lead Developer</span>
						</div>
						<p>Suite of bioinformatics operators for flow cytometry, scRNA-seq, and multi-omics analysis.</p>
						<div class="software-meta">
							<span class="tech">R, Docker</span>
						</div>
					</div>
					<div class="software-card">
						<div class="software-header">
							<h4>Co-introgression Test</h4>
							<span class="software-badge">Lead Developer</span>
						</div>
						<p>Statistical method for detecting coordinated adaptive introgression across gene networks in human populations.</p>
						<div class="software-meta">
							<span class="tech">R, Python</span>
						</div>
						<div class="software-links">
							<a href="https://doi.org/10.1093/molbev/msz299" target="_blank" rel="noopener">Paper</a>
						</div>
					</div>
					<div class="software-card">
						<div class="software-header">
							<h4>RND<sub>sp</sub></h4>
							<span class="software-badge">Lead Developer</span>
						</div>
						<p>Method for estimating species-specific relative node depth to detect lineage-specific selection in multi-species comparisons.</p>
						<div class="software-meta">
							<span class="tech">Python</span>
						</div>
						<div class="software-links">
							<a href="https://doi.org/10.1093/gbe/evae195" target="_blank" rel="noopener">Paper</a>
						</div>
					</div>
				</div>
			</section>

			<section id="cv" class="section">
				<h2>CV</h2>

				<section id="cv-experience" class="subsection">
					<h3 class="sub-heading">Experience</h3>
					<div class="timeline">
						<div class="timeline-item">
							<span class="timeline-date">2020&ndash;Present</span>
							<div class="timeline-content">
								<h4>Founder & Owner</h4>
								<p>AlgoLife SARL (formerly Gouy Data Consulting), France/Switzerland</p>
								<p class="timeline-details">Data science and software development for life sciences companies, universities, and local governments.</p>
								<p class="timeline-details" style="margin-bottom: var(--space-xs);"><strong>Selected projects:</strong></p>
								<ul class="timeline-projects">
									<li><strong>Head of Bioinformatics, Tercen</strong> (2022&ndash;2025) - Led bioinformatics and AI product development for a cloud-based multi-omics analysis platform. MCP server for automated data analysis selected for <strong>SLAS 2026 Innovation AveNEW</strong>.</li>
									<li><strong>Mitan</strong> - Geospatial forest monitoring platform combining remote sensing, ecology, and local knowledge. Deployed with NGOs and French communes. <a href="https://aumitan.com" target="_blank" rel="noopener">aumitan.com</a></li>
									<li>Predictive algorithm for IVF success rates, in collaboration with a health-tech startup and a major university hospital in Paris (AP-HP).</li>
								</ul>
							</div>
						</div>
						<div class="timeline-item">
							<span class="timeline-date">2020&ndash;2022</span>
							<div class="timeline-content">
								<h4>Senior Expert Data Science II</h4>
								<p>Novartis Pharma AG (via Brine SA), Basel, Switzerland</p>
								<p class="timeline-details">Contributed to Novartis's data42 initiative, applying AI and large-scale real-world data to drug discovery and development. Developed ML models on a large pharmaceutical dataset and contributed to the Map of Life platform for disease-gene-drug network analysis.</p>
							</div>
						</div>
						<div class="timeline-item">
							<span class="timeline-date">2022</span>
							<div class="timeline-content">
								<h4>Scientific Collaborator</h4>
								<p>University of Bern, Institute of Forensic Medicine</p>
								<p class="timeline-details">Statistical analysis of experimental data and forensic software development (STRAF 2). Two publications in forensic genetics.</p>
							</div>
						</div>
						<div class="timeline-item">
							<span class="timeline-date">2015&ndash;2019</span>
							<div class="timeline-content">
								<h4>PhD Candidate</h4>
								<p>University of Bern, Switzerland</p>
								<p class="timeline-details">Developed statistical and ML algorithms (Python, R, C++) for large-scale genomic datasets. 180 hours of teaching (Genomics, Statistics, R). Thesis defended <em>summa cum laude</em>.</p>
							</div>
						</div>
						<div class="timeline-item">
							<span class="timeline-date">2013&ndash;2015</span>
							<div class="timeline-content">
								<h4>Research Internships</h4>
								<p>University of Montpellier & CNRS Moulis, France</p>
								<p class="timeline-details">Three internships focused on genomics, scientific software development (C++), and molecular biology.</p>
							</div>
						</div>
						<div class="timeline-item">
							<span class="timeline-date">2012&ndash;2013</span>
							<div class="timeline-content">
								<h4>Computer Science Tutor</h4>
								<p>University of Limoges, France</p>
								<p class="timeline-details">Trained students for IT certificates (350 hours) and managed SQL databases.</p>
							</div>
						</div>
					</div>
				</section>

				<section id="cv-education" class="subsection">
					<h3 class="sub-heading">Education</h3>
					<div class="timeline">
						<div class="timeline-item">
							<span class="timeline-date">2015&ndash;2019</span>
							<div class="timeline-content">
								<h4>PhD in Ecology and Evolution (Genomics)</h4>
								<p>University of Bern, Switzerland &mdash; <em>summa cum laude</em></p>
								<p class="timeline-details">Thesis: "Detection of polygenic selection from genomic data: new insights into adaptation, introgression and speciation"<br/>
								Supervisor: Prof. Laurent Excoffier (SIB Swiss Institute of Bioinformatics)</p>
							</div>
						</div>
						<div class="timeline-item">
							<span class="timeline-date">2013&ndash;2015</span>
							<div class="timeline-content">
								<h4>Master's in Evolutionary Biology & Ecology</h4>
								<p>University of Montpellier, France &mdash; <em>Highest honors</em></p>
								<p class="timeline-details">Specialization: Population genomics and mathematical modeling<br/>
								Supervisors: François Rousset & Pierrick Labbé</p>
							</div>
						</div>
						<div class="timeline-item">
							<span class="timeline-date">2010&ndash;2013</span>
							<div class="timeline-content">
								<h4>Bachelor's in Population Biology</h4>
								<p>University of Limoges, France &mdash; <em>High honors</em></p>
							</div>
						</div>
					</div>
				</section>

				<section id="cv-teaching" class="subsection">
					<h3 class="sub-heading">Teaching & supervision</h3>
					<div class="teaching-grid">
						<div class="teaching-block">
							<h4>University teaching</h4>
							<ul>
								<li><strong>University of Bern</strong> (2015&ndash;2019) &mdash; 180h total: Genomics and Bioinformatics (Master's), Statistics for Biologists, Introduction to R, Population Genetics Seminars</li>
								<li><strong>University of Limoges</strong> (2012&ndash;2013) &mdash; 350h: IT certification training, database management (SQL)</li>
							</ul>
						</div>
						<div class="teaching-block">
							<h4>Student supervision</h4>
							<ul>
								<li>Engineering internship (2025) &mdash; AI automation of data analysis workflows</li>
								<li>Master's thesis (2019) &mdash; University of Bern, co-supervisor</li>
								<li>Master's thesis (2018) &mdash; ML methods in population genetics, University of Bern</li>
							</ul>
						</div>
					</div>
				</section>

			</section>

			<section id="media" class="section">
				<h2>Selected media coverage</h2>
				<div class="media-list">
					<div class="media-item">
						<span class="media-outlet">The Times</span>
						<a href="https://www.thetimes.com/uk/science/article/neanderthal-dna-gives-humans-healthy-advantage-9dwrg2q88" target="_blank" rel="noopener">Neanderthal DNA gives humans healthy advantage</a>
					</div>
					<div class="media-item">
						<span class="media-outlet">Newsweek</span>
						<a href="https://www.newsweek.com/interbreeding-neanderthals-denisovans-infectious-diseases-malaria-1482056" target="_blank" rel="noopener">Interbreeding with Neanderthals and Denisovans helped protect humans from infectious diseases</a>
					</div>
					<div class="media-item">
						<span class="media-outlet">Inverse</span>
						<a href="https://www.inverse.com/article/62293-neanderthal-densivoan-gene-inheritance-study" target="_blank" rel="noopener">Ancient sex with Neanderthals and Denisovans gave us key disease-fighting genes</a>
					</div>
					<div class="media-item">
						<span class="media-outlet">Heidi.news</span>
						<a href="https://www.heidi.news/sciences/les-etonnantes-traces-laissees-par-neandertal-et-denisova-dans-le-genome-humain" target="_blank" rel="noopener">Les étonnantes traces laissées par Néandertal et Denisova dans le génome humain</a>
					</div>
				</div>
			</section>
		</div>
	</div>
</Layout>

<style>
	/* Two-column layout: floating TOC + content */
	.page-grid {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: var(--space-2xl);
		align-items: start;
		margin-top: var(--space-2xl);
	}

	.toc {
		position: sticky;
		top: var(--space-xl);
		max-height: calc(100vh - var(--space-2xl));
		overflow-y: auto;
	}

	.toc-title {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-md);
	}

	.toc ul {
		list-style: none;
		padding: 0;
		margin: 0;
		border-left: 2px solid var(--color-border-light);
	}

	.toc li {
		margin: 0;
		padding: 0;
	}

	.toc-link {
		display: block;
		padding: var(--space-xs) var(--space-md);
		font-size: 0.85rem;
		color: var(--color-text-muted);
		border-left: 2px solid transparent;
		margin-left: -2px;
		transition: color 0.15s, border-color 0.15s;
		line-height: 1.4;
	}

	.toc-link:hover {
		color: var(--color-text);
	}

	.toc-link.active {
		color: var(--color-primary);
		border-left-color: var(--color-primary);
		font-weight: 500;
	}

	.toc-sub {
		border-left: none !important;
		padding-left: var(--space-md) !important;
	}

	.toc-link-sub {
		font-size: 0.8rem;
		padding-left: var(--space-sm);
	}

	.page-content {
		min-width: 0;
	}

	.page-content .section,
	.page-content .subsection {
		scroll-margin-top: var(--space-xl);
	}

	.subsection {
		margin-top: var(--space-2xl);
	}

	.subsection:first-of-type {
		margin-top: var(--space-lg);
	}

	.sub-heading {
		font-size: 1.1rem;
		color: var(--color-text);
		margin-top: var(--space-xl);
		margin-bottom: var(--space-md);
		padding-bottom: var(--space-xs);
		border-bottom: 1px solid var(--color-border-light);
	}

	.section > .sub-heading:first-of-type {
		margin-top: var(--space-md);
	}

	.subsection > .sub-heading {
		margin-top: 0;
	}

	/* Section utility */
	.card-icon {
		width: 28px;
		height: 28px;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.section-note {
		font-size: 0.9rem;
		font-style: italic;
		color: var(--color-text-muted);
		margin-bottom: var(--space-lg);
	}

	/* Timeline details */
	.timeline-details {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		margin-top: var(--space-xs);
		margin-bottom: 0;
	}

	.timeline-projects {
		list-style: none;
		padding: 0;
		margin-top: var(--space-sm);
		margin-bottom: 0;
	}

	.timeline-projects li {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		padding: var(--space-xs) 0;
		padding-left: var(--space-md);
		border-left: 2px solid var(--color-border);
		margin-bottom: var(--space-xs);
	}

	/* Software cards — compact */
	.software-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-md);
	}

	.software-card {
		background: var(--color-surface);
		padding: var(--space-md);
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
	}

	.software-card.featured {
		border-left: 3px solid var(--color-primary);
	}

	.software-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-xs);
		margin-bottom: var(--space-xs);
	}

	.software-header h4 {
		margin-bottom: 0;
		font-size: 0.95rem;
	}

	.software-badge {
		font-size: 0.65rem;
		font-weight: 600;
		padding: 2px var(--space-xs);
		background: rgba(8, 145, 178, 0.1);
		color: var(--color-accent);
		border-radius: var(--radius-sm);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.software-card p {
		font-size: 0.85rem;
		line-height: 1.4;
		margin-bottom: var(--space-xs);
	}

	.software-meta {
		display: flex;
		gap: var(--space-sm);
		margin-bottom: var(--space-xs);
	}

	.software-meta span {
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.software-links {
		display: flex;
		gap: var(--space-sm);
		flex-wrap: wrap;
	}

	.software-links a {
		font-size: 0.8rem;
		font-weight: 500;
	}

	/* Publication entries — compact */
	.publication {
		grid-template-columns: 50px 1fr;
		gap: var(--space-md);
		padding: var(--space-sm) 0;
	}

	.publication.thesis {
		padding: var(--space-md);
	}

	.pub-content h4 {
		font-size: 0.95rem;
		margin-bottom: 2px;
		line-height: 1.35;
		font-weight: 600;
	}

	.pub-content .pub-authors,
	.pub-content .pub-venue {
		font-size: 0.85rem;
		margin-bottom: 0;
		line-height: 1.4;
	}

